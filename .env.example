SHOPIFY_API_KEY="ASK DEVELOPER FOR THIS"
SHOPIFY_API_SECRET="ASK DEVELOPER FOR THIS"
SHOPIFY_SCOPES="ASK DEVELOPER FOR THIS"
SHOPIFY_STORE_DOMAIN="ASK DEVELOPER FOR THIS"
SHOPIFY_ACCESS_TOKEN="ASK DEVELOPER FOR THIS"
SHOPIFY_API_VERSION="ASK DEVELOPER FOR THIS"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="ASK DEVELOPER FOR THIS"
SHOPIFY_CDN_BASE_URL="ASK DEVELOPER FOR THIS"
SHOPIFY_STORE_URL="ASK DEVELOPER FOR THIS"
SHOPIFY_THEME_ID=                    # Optional: specify theme ID, otherwise fetches active theme

# Shopify Cache Configuration (TTL in seconds)
SHOPIFY_CACHE_ENABLED=true
SHOPIFY_CACHE_TTL_PRODUCT=900        # 15 minutes
SHOPIFY_CACHE_TTL_COLLECTION=1800    # 30 minutes
SHOPIFY_CACHE_TTL_CURRENCY=86400     # 24 hours
SHOPIFY_CACHE_TTL_CART=3600          # 1 hour

# Shopify HTTP Client Configuration
SHOPIFY_HTTP_TIMEOUT=30              # seconds
SHOPIFY_HTTP_CONNECT_TIMEOUT=10      # seconds

# Shopify Retry Configuration
SHOPIFY_RETRY_ENABLED=true
SHOPIFY_RETRY_MAX_ATTEMPTS=3
SHOPIFY_RETRY_INITIAL_DELAY_MS=100
SHOPIFY_RETRY_MAX_DELAY_MS=5000
SHOPIFY_RETRY_MULTIPLIER=2.0
SHOPIFY_RETRY_JITTER=true

# Shopify Circuit Breaker Configuration
SHOPIFY_CIRCUIT_BREAKER_ENABLED=true
SHOPIFY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
SHOPIFY_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
SHOPIFY_CIRCUIT_BREAKER_TIMEOUT_SECONDS=60
SHOPIFY_CIRCUIT_BREAKER_WINDOW_SECONDS=120

# Shopify Rate Limiting Configuration
SHOPIFY_RATE_LIMIT_ENABLED=true
SHOPIFY_RATE_LIMIT_MAX_ATTEMPTS=60
SHOPIFY_RATE_LIMIT_DECAY_MINUTES=1

# GraphQL Configuration
GRAPHQL_VERIFY_HASHES=false
GRAPHQL_CACHE_MINUTES=1440

# Currency Configuration
CURRENCY=GBP

FRONTEND_URL=https://scottstonebridge.com/pages/email-readings
BACKEND_URL=https://scottmobileapp.24livehost.com/api

# Admin user ID for generating weekly slots
ADMIN_USER_ID=4

# ----------------------------------------------------------------------------
# AI Chatbot Configuration
# ----------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_COMPLEX_MODEL=gpt-4.1
OPENAI_REQUEST_TIMEOUT=60

# Chatbot domain config
CHATBOT_ENABLED=true
CHATBOT_TOKEN_BUDGET_INPUT=3500
CHATBOT_TOKEN_BUDGET_OUTPUT=1100
CHATBOT_TEMPERATURE=0.6
CHATBOT_STREAM_MAX_ATTEMPTS=2
CHATBOT_HISTORY_TAIL=10
CHATBOT_INTENT_CONFIDENCE_THRESHOLD=0.65
CHATBOT_MESSAGE_MAX_LENGTH=2000
CHATBOT_RATE_LIMIT_PER_SESSION=20
CHATBOT_RATE_LIMIT_PER_IP=60
CHATBOT_CONTEXT_CACHE_TTL=180
CHATBOT_RECOMMENDATION_LIMIT=6
CHATBOT_ESCALATION_EMAIL=
CHATBOT_ESCALATION_SLACK_WEBHOOK=

# Redis-backed queue/cache connection for AI workload only
# (defaults preserved: existing audio queue + cache remain on `database`)
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=ai
REDIS_QUEUE_RETRY_AFTER=120

# Horizon
HORIZON_PREFIX=ssb-horizon:
HORIZON_DOMAIN=
HORIZON_PATH=horizon

# ----------------------------------------------------------------------------
# AI Sales Agent (Phase 2) Configuration
# ----------------------------------------------------------------------------

# Queue connection + per-feature queue names (all dispatched onto redis)
CHATBOT_SALES_QUEUE_CONNECTION=redis
CHATBOT_SALES_QUEUE=sales
CHATBOT_RECOVERY_QUEUE=recovery
CHATBOT_SYNC_QUEUE=sync
CHATBOT_ANALYTICS_QUEUE=analytics

# Proactive triggers
SALES_TRIGGER_FIRED_TTL=86400

# Lead capture + abandon recovery
SALES_RECOVERY_DELAY_MINUTES=30

# Upsell / cross-sell intelligence
SALES_UPSELL_MAX_RESULTS=3
SALES_UPSELL_CACHE_TTL=600
# Ordered Shopify recommendation intents (first non-empty wins): COMPLEMENTARY,RELATED
SALES_UPSELL_INTENTS=COMPLEMENTARY,RELATED

# Store knowledge sync
KNOWLEDGE_SYNC_HOUR=2
SALES_KNOWLEDGE_CACHE_TTL=86400
SALES_KNOWLEDGE_ITEM_TOKENS=300
SALES_KNOWLEDGE_PROMPT_TOKENS=500
SALES_KNOWLEDGE_PAGE_SIZE=50
SALES_KNOWLEDGE_ENABLE_SEMANTIC=true

# Multi-language
CHATBOT_FALLBACK_LOCALE=en
SALES_LOCALE_CACHE_TTL=7200

# Prompt budget guard
SALES_SYSTEM_PROMPT_MAX_TOKENS=1600

# ----------------------------------------------------------------------------
# AI Sales Agent (Phase 3 — Shopify MCP + Customer Account OAuth)
# ----------------------------------------------------------------------------

# Storefront MCP endpoints. `{shop}` is substituted with the active shop domain
# at call time, so the same default works across all multi-tenant shops.
SHOPIFY_MCP_STOREFRONT=https://{shop}/api/mcp
SHOPIFY_MCP_UCP=https://{shop}/api/mcp
SHOPIFY_MCP_TIMEOUT_MS=15000

# Customer Account API OAuth client (PKCE flow, public client — no secret).
SHOPIFY_CUSTOMER_CLIENT_ID=
SHOPIFY_CUSTOMER_CLIENT_SECRET=
SHOPIFY_CUSTOMER_REDIRECT_URI=https://scottmobileapp.24livehost.com/api/v1/ai/oauth/customer/callback
SHOPIFY_OAUTH_PKCE_TTL=600
SHOPIFY_OAUTH_TOKEN_TTL=3600
SHOPIFY_CUSTOMER_SCOPES="openid email customer-account-api:full customer-account-mcp-api:full"


# Email Reading Webhook Automation
SHOPIFY_WEBHOOK_HMAC_ENABLED=false
SHOPIFY_WEBHOOK_SECRET=
READINGS_QUEUE_CONNECTION=database
READINGS_TEST_EMAILS=deepak.sharma5@dotsquares.com,mahendra.mali@dotsquares.com,ajay.yadav@dotsquares.com
READINGS_SCHEDULE_ENABLED=true
READINGS_SCHEDULE_MIN_DAYS=3
READINGS_SCHEDULE_MAX_DAYS=7
READINGS_EXPEDITE_ENABLED=true
READINGS_EXPEDITE_MIN_HOURS=2
READINGS_EXPEDITE_MAX_HOURS=24
READINGS_FULFILL_ENABLED=true
READINGS_FULFILL_NOTIFY_CUSTOMER=false


# Marketing Push Notifications (Klaviyo email -> FCM)
PUSH_ENABLED=false
PUSH_QUEUE_CONNECTION=database
# PUSH_QUEUE=push
# PUSH_FANOUT_QUEUE=push-fanout
# PUSH_TEST_EMAILS=deepak.sharma5@dotsquares.com

# Klaviyo API + flow webhook auth
KLAVIYO_API_KEY=
KLAVIYO_API_REVISION=2025-04-15
KLAVIYO_WEBHOOK_SECRET=
KLAVIYO_WEBHOOK_AUTH_ENABLED=true
# Resolve once via KlaviyoApiClient::getMetricId('Received Email')
KLAVIYO_RECEIVED_EMAIL_METRIC_ID=
# Seconds a flow message's fetched subject/preview_text is cached for
KLAVIYO_MESSAGE_CONTENT_CACHE_TTL=900

# Campaign sweep (near-real-time; no paid add-on required)
PUSH_SWEEP_ENABLED=false
PUSH_SWEEP_LOOKBACK_HOURS=24
PUSH_SWEEP_SETTLE_MINUTES=15
PUSH_SWEEP_PAGE_SIZE=200

# Firebase Cloud Messaging — absolute path to the Admin SDK service-account
# JSON, kept outside the webroot. Read directly by kreait/laravel-firebase;
# the project ID comes from inside that JSON file, there is no separate var.
FIREBASE_CREDENTIALS=

# Push notification default copy / deep link
PUSH_DEFAULT_TITLE="New from Scott Stonebridge"
PUSH_DEFAULT_BODY="We just sent you something special — take a look."
PUSH_DEFAULT_DEEP_LINK=app://home
PUSH_LOG_SKIPPED=false